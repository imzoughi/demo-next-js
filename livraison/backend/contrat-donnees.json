{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "titre": "Contrat de données — Avion, boutique démo",
  "version": "1.1.0",
  "notes": "Une entité par objet métier affiché par le front. Noms = types TypeScript de src/mocks/types.ts, src/mocks/account.ts et src/mocks/stores.ts. Montants en euros TTC (nombre décimal). Les fonctions d’accès sont dans src/lib/api/index.ts. Entrées d’action (ProfileUpdate, PasswordChange, FavoriteStore) : pas de type dans le code, à créer côté API.",
  "entites": {
    "Product": {
      "description": "Produit du catalogue : listes « à la une », fiche produit, suggestions.",
      "type": "object",
      "required": [
        "id",
        "name",
        "price",
        "image",
        "imageAlt",
        "href",
        "category",
        "description",
        "dimensions",
        "max"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "identifiant stable (slug)"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "description": "prix unitaire en euros TTC"
        },
        "image": {
          "type": "string",
          "description": "URL ou chemin de l’image (aujourd’hui : public/images/…)"
        },
        "imageAlt": {
          "type": "string",
          "description": "texte alternatif (obligatoire, accessibilité)"
        },
        "href": {
          "type": "string",
          "description": "lien vers la fiche produit"
        },
        "category": {
          "type": "string",
          "description": "libellé de catégorie affiché (fil d’Ariane)"
        },
        "description": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "max": {
          "type": "integer",
          "description": "stock disponible : plafond du sélecteur de quantité"
        }
      }
    },
    "ListedProduct": {
      "description": "Produit de la page liste : sous-ensemble de Product + valeurs des filtres.",
      "type": "object",
      "required": [
        "id",
        "name",
        "price",
        "image",
        "imageAlt",
        "href",
        "category",
        "material"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "description": "euros TTC"
        },
        "image": {
          "type": "string",
          "description": "URL ou chemin de l’image (aujourd’hui : public/images/…)"
        },
        "imageAlt": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "valeur du filtre « Catégorie » (ex. ceramiques)"
        },
        "material": {
          "type": "string",
          "description": "valeur du filtre « Matière » (ex. chene)"
        }
      }
    },
    "CartLine": {
      "description": "Ligne du panier (MiniCart, page panier, récapitulatif du paiement).",
      "type": "object",
      "required": [
        "id",
        "name",
        "unitPrice",
        "quantity",
        "max",
        "image",
        "imageAlt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "id du produit"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unitPrice": {
          "type": "number",
          "description": "euros TTC"
        },
        "quantity": {
          "type": "integer"
        },
        "max": {
          "type": "integer",
          "description": "stock disponible"
        },
        "image": {
          "type": "string",
          "description": "URL ou chemin de l’image (aujourd’hui : public/images/…)"
        },
        "imageAlt": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "Order": {
      "description": "Commande passée (liste du compte et fiche /compte/commandes/[numero]). Détail complet : articles, livraison, adresse, paiement.",
      "type": "object",
      "required": [
        "number",
        "date",
        "status",
        "total",
        "items",
        "shipping",
        "shippingAddress",
        "payment"
      ],
      "properties": {
        "number": {
          "type": "string",
          "description": "numéro de commande, identifiant de la page /compte/commandes/{number}/"
        },
        "date": {
          "type": "string",
          "description": "date affichée telle quelle (ex. « 29 septembre 2026 ») ; voir Points ouverts"
        },
        "status": {
          "type": "string",
          "enum": [
            "En préparation",
            "Expédiée",
            "Livrée"
          ]
        },
        "total": {
          "type": "number",
          "description": "total payé en euros TTC = somme des articles + shipping"
        },
        "href": {
          "type": "string",
          "description": "calculé par le front (orderHref) : à ne pas fournir"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/entites/OrderItem"
          },
          "description": "au moins un article"
        },
        "shipping": {
          "type": "number",
          "description": "frais de livraison en euros ; 0 = offerts"
        },
        "shippingAddress": {
          "$ref": "#/entites/OrderAddress"
        },
        "payment": {
          "type": "string",
          "description": "mode de paiement affiché tel quel, ex. « Carte bancaire se terminant par 4242 ». Jamais de numéro de carte complet."
        }
      }
    },
    "Category": {
      "description": "Lien de catégorie (menu, pied de page).",
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      }
    },
    "FilterGroup": {
      "description": "Groupe de filtres de la liste produits.",
      "type": "object",
      "required": [
        "id",
        "legend",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "legend": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label",
              "count"
            ],
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "description": "nombre de produits ; 0 = option désactivée"
              }
            }
          }
        }
      }
    },
    "SortOption": {
      "description": "Option de tri de la liste produits.",
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "HomeContent": {
      "description": "Textes et images éditoriaux de l’accueil (et de la newsletter, réutilisée sur la fiche produit).",
      "type": "object",
      "required": [
        "hero",
        "featuresTitle",
        "featuredTitle",
        "story",
        "newsletter"
      ],
      "properties": {
        "hero": {
          "type": "object",
          "required": [
            "title",
            "text",
            "image",
            "imageAlt",
            "actionLabel",
            "actionHref"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "imageAlt": {
              "type": "string"
            },
            "actionLabel": {
              "type": "string"
            },
            "actionHref": {
              "type": "string"
            }
          }
        },
        "featuresTitle": {
          "type": "string"
        },
        "featuredTitle": {
          "type": "string"
        },
        "story": {
          "type": "object",
          "required": [
            "title",
            "text",
            "image",
            "imageAlt",
            "actionLabel",
            "actionHref"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "image": {
              "type": "string"
            },
            "imageAlt": {
              "type": "string"
            },
            "actionLabel": {
              "type": "string"
            },
            "actionHref": {
              "type": "string"
            }
          }
        },
        "newsletter": {
          "type": "object",
          "required": [
            "title",
            "text",
            "benefits"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "benefits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Account": {
      "description": "Espace client : profil, commandes (détaillées), adresses, magasin favori (type AccountData dans le code, favori en plus à ajouter).",
      "type": "object",
      "required": [
        "profile",
        "orders",
        "addresses"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "required": [
            "firstName",
            "lastName",
            "email",
            "phone"
          ],
          "properties": {
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "phone": {
              "type": "string"
            }
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "$ref": "#/entites/Order"
          }
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "name",
              "lines"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isDefault": {
                "type": "boolean"
              }
            }
          }
        },
        "favoriteStoreId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Store.id du magasin favori ; absent dans le code actuel (gardé en session simulée), à fournir par l’API"
        }
      }
    },
    "ProductPage": {
      "description": "Données de la fiche produit (getProductPage) : produit, suggestions et textes.",
      "type": "object",
      "required": [
        "product",
        "related",
        "relatedTitle",
        "breadcrumbHome"
      ],
      "properties": {
        "product": {
          "$ref": "#/entites/Product"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/entites/Product"
          }
        },
        "relatedTitle": {
          "type": "string"
        },
        "breadcrumbHome": {
          "type": "string"
        }
      }
    },
    "OrderItem": {
      "description": "Article d’une commande passée (copie figée à la date de la commande : nom, prix et image ne suivent pas le catalogue).",
      "type": "object",
      "required": [
        "id",
        "name",
        "unitPrice",
        "quantity",
        "image",
        "imageAlt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "id du produit"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "unitPrice": {
          "type": "number",
          "description": "prix unitaire en euros TTC au moment de la commande"
        },
        "quantity": {
          "type": "integer"
        },
        "image": {
          "type": "string",
          "description": "URL ou chemin de l’image"
        },
        "imageAlt": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "description": "lien vers la fiche produit"
        }
      }
    },
    "OrderAddress": {
      "description": "Adresse de livraison figée sur une commande (nom du destinataire + lignes d’adresse affichées telles quelles).",
      "type": "object",
      "required": [
        "name",
        "lines"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "une ligne par ligne d’adresse (rue, code postal et ville, pays)"
        }
      }
    },
    "Store": {
      "description": "Magasin (page /compte/magasin/ : liste, recherche, favori).",
      "type": "object",
      "required": [
        "id",
        "name",
        "address",
        "postalCode",
        "city",
        "hours",
        "phone",
        "services"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "identifiant stable (slug)"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "description": "numéro et rue"
        },
        "postalCode": {
          "type": "string",
          "description": "5 chiffres ; la recherche compare le début"
        },
        "city": {
          "type": "string",
          "description": "la recherche ignore casse et accents"
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "une ligne par plage d’horaires, texte affiché tel quel"
        },
        "phone": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ProfileUpdate": {
      "description": "Entrée de « Enregistrer mes informations » (/compte/informations/) : mêmes champs que Account.profile, tous obligatoires.",
      "type": "object",
      "required": [
        "firstName",
        "lastName",
        "email",
        "phone"
      ],
      "properties": {
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "dix chiffres (06 12 34 56 78) ou +33 suivi de neuf chiffres ; espaces, points et tirets tolérés"
        }
      }
    },
    "PasswordChange": {
      "description": "Entrée de « Changer le mot de passe ». La confirmation est contrôlée par le front et n’est pas envoyée. Valeur secrète : ne jamais journaliser ni stocker côté navigateur.",
      "type": "object",
      "required": [
        "currentPassword",
        "newPassword"
      ],
      "properties": {
        "currentPassword": {
          "type": "string"
        },
        "newPassword": {
          "type": "string",
          "description": "au moins 8 caractères, une majuscule, un chiffre ; différent de l’actuel"
        }
      }
    },
    "FavoriteStore": {
      "description": "Magasin favori du compte (un seul, ou aucun). Entrée de PUT /me/favorite-store ; la lecture renvoie la même forme avec storeId null si aucun favori.",
      "type": "object",
      "required": [
        "storeId"
      ],
      "properties": {
        "storeId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Store.id ; null = retirer des favoris"
        }
      }
    }
  },
  "exemples": {
    "Product": "exemples/product.json",
    "ListedProduct": "exemples/listed-product.json",
    "CartLine": "exemples/cart-line.json",
    "Order": "exemples/order.json",
    "Category": "exemples/category.json",
    "FilterGroup": "exemples/filter-group.json",
    "SortOption": "exemples/sort-option.json",
    "HomeContent": "exemples/home-content.json",
    "Account": "exemples/account.json",
    "ProductPage": "exemples/product-page.json",
    "OrderItem": "exemples/order-item.json",
    "OrderAddress": "exemples/order-address.json",
    "Store": "exemples/store.json",
    "ProfileUpdate": "exemples/profile-update.json",
    "PasswordChange": "exemples/password-change.json",
    "FavoriteStore": "exemples/favorite-store.json"
  }
}
