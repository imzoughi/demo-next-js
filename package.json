{
  "name": "boutique-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 4000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build && npm run docs:check",
    "docs:catalog": "node scripts/build-catalog.mjs",
    "docs:check": "node scripts/check-docs.mjs out --prefix /docs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "shots": "playwright test --grep @shots",
    "test:ui": "playwright test",
    "perf": "lhci autorun",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "sass": "^1.105.1",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
